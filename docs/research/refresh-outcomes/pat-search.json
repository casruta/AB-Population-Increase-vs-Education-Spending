modified": "2026-09-04T14:57:06.186572", "name": "the-teaching-practices-project", "notes": "This research project investigates teaching practices in Alberta schools where students consistently exceed expectations on Grade 9 provincial achievement tests (PATs) in mathematics. Through 15 case studies across diverse school types and regions, the study explores the complex, contextual nature of effective teaching. Common features among high-performing teachers include strong content knowledge, thoughtful preparation, high expectations, interactive instruction, and reflective practice. These educators make math meaningful and relevant, balance skill development with conceptual understanding, and foster classroom environments rich in discourse, risk-taking, and student engagement. The findings highlight that effective teaching is personal and adaptive, rooted in both professional dedication and a deep sense of ownership over the curriculum.", "num_resources": 1, "num_tags": 2, "organization": {"id": "079da4a3-1719-4361-9168-219985d29cf3", "name": "education", "title": "Education", "type": "organization", "description": "", "image_url": "", "created": "2015-05-13T08:55:38.599044", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "079da4a3-1719-4361-9168-219985d29cf3", "private": false, "pubtype": ["Report"], "sensitivity": "unrestricted", "state": "active", "subject": "Teaching -- Methodology", "subject2": "Mathematics -- Study and teaching (Secondary) -- Alberta", "title": "The Teaching Practices Project : research into teaching practices in Alberta schools that have a history of students exceeding expectations on grade 9 provincial achievement tests in mathematics", "topic": ["Education - Early Childhood to Grade 12"], "type": "publications", "updatefrequency": "Once", "url": null, "usageconsiderations": "Digital reproduction of a Government of Alberta print publication.", "version": null, "resources": [{"cache_last_updated": null